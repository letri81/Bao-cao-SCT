                <TablixCell><CellContents><Textbox Name="H_OutCurr"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Thực tế năm " &amp; Parameters!p_ReportYear.Value &amp; " (kWh)"</Value><Style><FontFamily>Times New Roman</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#666666</Color><Style>Solid</Style></Border><BackgroundColor>#D9E2F3</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
