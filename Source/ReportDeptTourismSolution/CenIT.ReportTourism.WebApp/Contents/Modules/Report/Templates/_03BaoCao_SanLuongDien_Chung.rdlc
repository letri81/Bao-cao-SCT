<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="TitleTextbox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>THEO DÕI SẢN LƯỢNG ĐIỆN 74 NHÀ MÁY ĐIỆN VÀ ĐIỆN MẶT TRỜI MÁI NHÀ</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.2in</Top>
        <Left>0.5in</Left>
        <Height>0.35in</Height>
        <Width>12.6in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
      <Textbox Name="SubtitleTextbox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Kỳ so sánh năm " &amp; CStr(CInt(Parameters!p_ReportYear.Value)-1) &amp; " và năm " &amp; Parameters!p_ReportYear.Value &amp; " (Lũy kế " &amp; Parameters!p_PeriodMonth.Value &amp; " tháng)"</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.55in</Top>
        <Left>0.5in</Left>
        <Height>0.25in</Height>
        <Width>12.6in</Width>
        <Style>
          <Border><Style>None</Style></Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
