                <TablixCell><CellContents><Textbox Name="H_CapTitle2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Công suất</Value><Style><FontFamily>Times New Roman</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#666666</Color><Style>Solid</Style></Border><BackgroundColor>#D9E2F3</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
