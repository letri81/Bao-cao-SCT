@model CenIT.ReportTourism.Modules.ReportModule.Areas.Report.Models.ReportViewModel

@Html.HiddenFor(model => model.ReportKey)
@Html.HiddenFor(model => model.ReportName)
@Html.HiddenFor(model => model.ViewName)
@Html.HiddenFor(model => model.Reporter)

<div id="BaoCao_SanLuongDien_Chung">
    <div class="form-group row">
        <label class="control-label col-md-3">Năm báo cáo</label>
        <div class="col-md-9">
            <select name="ReportYear" id="ReportYear" class="form-control">
                @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                {
                    <option value="@y" @(y == DateTime.Now.Year ? "selected" : "")>Năm @y</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group row">
        <label class="control-label col-md-3">Kỳ lũy kế so sánh</label>
        <div class="col-md-9">
            <select name="PeriodMonth" id="PeriodMonth" class="form-control">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" @(m == 9 ? "selected" : "")>@m tháng đầu năm</option>
                }
            </select>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
    });
</script>

